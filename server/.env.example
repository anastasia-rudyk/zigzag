# Рядок підключення до MongoDB Atlas (або локальної БД: mongodb://localhost:27017/ukrroute)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ukrroute

# Секрет для підпису JWT — будь-який довгий випадковий рядок
JWT_SECRET=change-me-to-a-long-random-string

# Порт сервера
PORT=5000

# Адреса сервісу OSRM (публічний демо-сервер; для продакшну краще власний)
OSRM_URL=https://router.project-osrm.org

# Пароль адміністратора, якого створює seed-скрипт
SEED_ADMIN_PASSWORD=admin12345
